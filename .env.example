# Copy to .env. Never put server-only values in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
FASTAPI_INTERNAL_BASE_URL=http://api:8000
DATABASE_URL=postgresql+psycopg://gapfinder:gapfinder@postgres:5432/gapfinder
REDIS_URL=redis://redis:6379/0
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_STT_MODEL_ID=scribe_v2
# Cloudflare Worker (infra/cloudflare-image-worker): illustrations AND embeddings (/embed, open-source
# Qwen3-Embedding-0.6B). Required: without it, uploads cannot be embedded.
CLOUDFLARE_IMAGE_WORKER_URL=
CLOUDFLARE_IMAGE_WORKER_SHARED_SECRET=
OCR_LANGUAGES=eng+hin+pan+tel
APP_SIGNING_SECRET=
# --- Render / no-worker mode (leave unset for local) ---
# TASK_RUNNER=inline            # run jobs on threads in the API instead of a Celery worker
# INLINE_WORKERS=2
